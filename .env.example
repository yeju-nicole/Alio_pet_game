# Copy to .env (or set these in your hosting provider's dashboard).

# Required in production: password for /admin
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Public address of the game (used in links handed to alio's website)
PUBLIC_URL=https://pet.example.com

# Where the SQLite database lives. Point this at a persistent disk.
DATA_DIR=/data

PORT=3000

# Optional: fixed API key for alio's website. If unset, one is generated on first
# start and shown in /admin → "alio 연동 가이드".
# PARTNER_API_KEY=

# Optional: turns on AI photo checks for eco missions (otherwise photos are self-reported).
# ANTHROPIC_API_KEY=

# Behind a reverse proxy / load balancer, how many proxy hops to trust (default 1 in production).
# TRUST_PROXY=1

# Cookies are Secure (HTTPS-only) in production. Set false only for local http testing.
# COOKIE_SECURE=true
